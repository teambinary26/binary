    <diagram id="notes" name="3. Keys, enums and rules">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="  LYDO Nabua CAMS  ·  Identifiers, enumerations, and integrity rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=20;align=left;spacingLeft=20;" vertex="1" parent="1">
                    <mxGeometry x="0" y="0" width="1600" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="IDENTIFIERS&lt;br&gt;&lt;br&gt;applications.application_no   CAMS-{YEAR}-{6-digit seq}   unique&lt;br&gt;applicants.applicant_no         BEN-{YEAR}-{6-digit seq}    unique, 1:1 with users&lt;br&gt;assistance_releases.reference_no   REL-{YEAR}-{seq}         unique&lt;br&gt;assistance_releases.verification_code   unique QR / claim code&lt;br&gt;assistance_programs.code / slug   unique (e.g. EDU-001, MED-001)&lt;br&gt;users.email, roles.slug, permissions.slug, system_settings.key   unique" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="40" y="80" width="740" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="ENUMERATIONS (stored as strings)&lt;br&gt;&lt;br&gt;users via roles.slug: administrator | staff | applicant&lt;br&gt;applications.status: draft, accepted, submitted, under_verification,&lt;br&gt;  incomplete, under_evaluation, for_approval, approved, rejected,&lt;br&gt;  for_revision, scheduled_for_release, released, completed, cancelled&lt;br&gt;document_verifications.status: pending | verified | rejected | revision_requested&lt;br&gt;workflow_staff.workflow_step: verification | evaluation | approval&lt;br&gt;beneficiary_type: student | non_student | both (programs)&lt;br&gt;release_method: cash | bank_transfer | ewallet | check | other&lt;br&gt;evaluation.recommendation / approval.decision: approval/approved | rejection/rejected | revision&lt;br&gt;eligibility check_mode: ocr | manual&lt;br&gt;ocr overall_status: matched | mismatch | review | type_mismatch | failed | extracted" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="800" y="80" width="760" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="CARDINALITY HIGHLIGHTS&lt;br&gt;&lt;br&gt;User 1 — 0..1 Applicant          (staff have no applicant row)&lt;br&gt;Applicant 1 — 0..1 Profile       (created with the account)&lt;br&gt;Applicant 1 — * Addresses        (one flagged is_primary)&lt;br&gt;Applicant 1 — * Applications     (restrict delete; one current non-terminal app)&lt;br&gt;Program 1 — * Applications       (restrict delete)&lt;br&gt;Application 1 — * Answers, Documents, History, Evaluations, Approvals, Schedules, Releases&lt;br&gt;Document 1 — 0..1 Verification   (unique FK)&lt;br&gt;Document 1 — 0..1 OcrResult      (unique FK)&lt;br&gt;OcrResult 1 — * Extracted fields&lt;br&gt;Role * — * Permission            (role_permissions)&lt;br&gt;User 1 — * WorkflowStaff         (unique per step)&lt;br&gt;AuditLog optional morph          (subject_type, subject_id)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="40" y="320" width="740" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="FOREIGN KEY DELETE RULES&lt;br&gt;&lt;br&gt;CASCADE — dependent rows go with the parent&lt;br&gt;  applicant ↔ user, profile, addresses&lt;br&gt;  program → requirements, rules, form fields&lt;br&gt;  application → answers, documents, history, evaluations, approvals, notifications&lt;br&gt;  document → verification, OCR result → extracted fields&lt;br&gt;  release → release_verifications; role_permissions; workflow_staff&lt;br&gt;&lt;br&gt;RESTRICT — cannot delete parent while children exist&lt;br&gt;  category → programs; applicant/program → applications&lt;br&gt;  evaluator, officer, scheduled_by, released_by, author, verified_by (claim)&lt;br&gt;&lt;br&gt;SET NULL — keep the child, clear the FK&lt;br&gt;  users.role_id, assigned_staff_id, verified_by (documents)&lt;br&gt;  program_form_field_id, program_requirement_id on submissions&lt;br&gt;  application_id on notifications and audit_logs&lt;br&gt;  release_schedule_id on assistance_releases" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="800" y="380" width="760" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="SUBJECT AREAS (header colours)&lt;br&gt;&lt;br&gt;Navy     Authentication, roles, workflow staff&lt;br&gt;Teal     Applicants, profiles, addresses&lt;br&gt;Blue     Program catalogue, requirements, rules, form fields&lt;br&gt;Amber    Applications and processing records&lt;br&gt;Violet   Uploaded files, verification, OCR&lt;br&gt;Green    Release schedules, payouts, claim checks&lt;br&gt;Pink     Announcements and in-app notifications&lt;br&gt;Grey     Audit log and system settings" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="40" y="660" width="740" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="NOT ON THIS DIAGRAM&lt;br&gt;&lt;br&gt;cache, cache_locks, jobs, job_batches, failed_jobs&lt;br&gt;(Laravel infrastructure — not domain data)&lt;br&gt;&lt;br&gt;Source of truth: database/migrations&lt;br&gt;especially 2024_01_01_000003_create_cams_tables.php&lt;br&gt;plus later OCR, PWD, pending_account, and check_mode migrations." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="800" y="760" width="760" height="180" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>