    <diagram id="staff" name="4. Verify, Evaluate, Approve, Release">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="4120" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="  4. Staff processing pipeline — verification, evaluation, approval, release" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=20;align=left;spacingLeft=20;" vertex="1" parent="1">
                    <mxGeometry x="0" y="0" width="1680" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="Non-admin staff only see a queue if they have the step permission and a workflow_staff assignment. Administrators bypass assignment checks. Load-balanced assigned_staff_id." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
                    <mxGeometry x="40" y="66" width="1600" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="A. DOCUMENT VERIFICATION  ·  permission applications.verify  ·  queue: submitted, under_verification, incomplete, for_revision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;dashPattern=8 8;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#1E3A5F;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="110" width="1600" height="980" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="Staff opens verification queue&lt;br&gt;/admin/verification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="620" y="170" width="340" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="First action on a submitted&lt;br&gt;file may move status to&lt;br&gt;under_verification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="620" y="260" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="For each document,&lt;br&gt;choose an action" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="630" y="360" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="verify → document verified&lt;br&gt;Application status unchanged" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="120" y="370" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="revision → revision_requested&lt;br&gt;Application → for_revision&lt;br&gt;DocumentRevisionMail + notify" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="120" y="470" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="reject → document rejected&lt;br&gt;Application → incomplete&lt;br&gt;In-app notify applicant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="120" y="590" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="Applicant replaces the file&lt;br&gt;New OCR run&lt;br&gt;Status → under_verification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E8F1F8;strokeColor=#1B4F72;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
                    <mxGeometry x="120" y="710" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="Staff may re-run OCR&lt;br&gt;or correct OCR fields (rescore).&lt;br&gt;Corrections do not verify the document." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;align=left;spacingLeft=8;fontSize=10;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="360" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="All required documents&lt;br&gt;have status verified?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="630" y="500" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="Keep working the queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E8F1F8;strokeColor=#1B4F72;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
