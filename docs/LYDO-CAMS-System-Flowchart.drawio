    <diagram id="documents" name="3. Draft Review &amp; Documents">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="3180" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="  3. Staff accept the draft, then the applicant completes documents" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=20;align=left;spacingLeft=20;" vertex="1" parent="1">
                    <mxGeometry x="0" y="0" width="1600" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="A. INITIAL DRAFT REVIEW  (administrator or staff with applications.approve)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;dashPattern=8 8;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#1E3A5F;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="80" width="1520" height="720" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Draft appears on&lt;br&gt;application show page" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="580" y="140" width="320" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="Accept this&lt;br&gt;applicant?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="600" y="240" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="POST approve-applicant reject&lt;br&gt;draft → rejected" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="160" y="250" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="rejected  (terminal)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#9B1C1C;fontColor=#FFFFFF;strokeColor=#7F1D1D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
