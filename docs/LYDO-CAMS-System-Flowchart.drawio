        <mxCell id="27" value="POST complete-verification&lt;br&gt;status → under_evaluation&lt;br&gt;Assign evaluation staff&lt;br&gt;Notify applicant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
