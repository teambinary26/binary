                <mxCell id="14" value="incomplete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#B45309;fontColor=#FFFFFF;strokeColor=#92400E;fontStyle=1;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="680" y="280" width="150" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="for_revision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#B45309;fontColor=#FFFFFF;strokeColor=#92400E;fontStyle=1;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="920" y="280" width="150" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="rejected" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#9B1C1C;fontColor=#FFFFFF;strokeColor=#7F1D1D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="1150" y="280" width="140" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="cancelled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#9B1C1C;fontColor=#FFFFFF;strokeColor=#7F1D1D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="80" y="280" width="140" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="36" value="Document statuses: pending → verified | rejected | revision_requested&lt;br&gt;Public timeline (happy path): submitted → under_verification → under_evaluation → for_approval → approved → scheduled_for_release → released → completed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;spacingLeft=10;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="40" y="360" width="1920" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="37" value="OCR PIPELINE (DocumentOcrService)&lt;br&gt;1. Applicant (or staff) uploads / scans a file&lt;br&gt;2. OCR.space returns raw_text (OCRSPACE_API_KEY)&lt;br&gt;3. Expected type from requirement name vs detected type&lt;br&gt;4. Extracted fields compared with applicant, profile, address, answers&lt;br&gt;5. overall_status: matched | mismatch | review | type_mismatch | failed | extracted&lt;br&gt;6. Staff can correct fields and rescore; that is not the same as verifying the document&lt;br&gt;OCR corpus for eligibility excludes rejected and revision_requested files" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="40" y="440" width="630" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="38" value="ELIGIBILITY RULES (EligibilityAssessmentService)&lt;br&gt;Operators: contains, equals, not_contains, min, max, present&lt;br&gt;Check modes: ocr (scan documents) or manual (staff tick)&lt;br&gt;Typical seeded rules: resident of Nabua, currently enrolled,&lt;br&gt;tuition assessment present, no duplicate award this academic year&lt;br&gt;Manual examples: prior assistance, school outside barangay, family relationship&lt;br&gt;Result is per-rule passed / failed / review — not a single application score&lt;br&gt;Evaluation still requires a human recommendation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="690" y="440" width="640" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="39" value="PERMISSIONS (staff modules)&lt;br&gt;dashboard.view&lt;br&gt;applicants.view / manage&lt;br&gt;applications.view / manage / verify / evaluate / approve&lt;br&gt;programs.view / manage&lt;br&gt;releases.view / manage / verify&lt;br&gt;reports.view&lt;br&gt;announcements.view / manage&lt;br&gt;users.view / manage · roles.manage&lt;br&gt;audit.view · settings.view / manage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="1350" y="440" width="610" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="40" value="IN-APP NOTIFICATIONS (no email)&lt;br&gt;Submitted · document verified · evaluated · approved/rejected · release recorded · OCR type mismatch · revision / incomplete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;spacingLeft=10;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="40" y="680" width="1920" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="41" value="DATA STORED WITH AN APPLICATION&lt;br&gt;ApplicationAnswer · DocumentSubmission → DocumentVerification + OcrResult → OcrExtractedField&lt;br&gt;ApplicationStatusHistory · ApplicationEvaluation (eligibility_checks JSON) · ApplicationApproval&lt;br&gt;ReleaseSchedule · AssistanceRelease → ReleaseVerification&lt;br&gt;assigned_staff_id (User)  ·  WorkflowStaff (step + user)  ·  SystemNotification  ·  AuditLog" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="40" y="750" width="960" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="42" value="SECURITY &amp; GATES&lt;br&gt;Turnstile session 30 minutes; OTP cache apply-otp:{email}&lt;br&gt;Throttles: turnstile 20/min · OTP 5/min · submit 10/min&lt;br&gt;Middleware: staff (not applicant) · applicant (must have Applicant row)&lt;br&gt;permission:{slug} on admin routes · ApplicationPolicy for verify/evaluate/approve&lt;br&gt;Passwords for pending public applicants are issued only after accept or final approve" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="750" width="940" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="43" value="STACK: Laravel 12 + Inertia.js + Vue 3  ·  Ziggy routes  ·  MySQL/SQLite  ·  OCR.space  ·  Cloudflare Turnstile&lt;br&gt;Config: config/cams.php (agency, barangays, release methods)  ·  SystemSetting overrides agency display fields" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;align=left;spacingLeft=8;fontSize=10;fontColor=#0F172A;" vertex="1" parent="1">
                    <mxGeometry x="40" y="930" width="1920" height="56" as="geometry"/>
                </mxCell>
