                </mxCell>
                <mxCell id="11" value="accepted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#166534;fontColor=#FFFFFF;strokeColor=#14532D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="670" y="520" width="140" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="In-app: “Application accepted”&lt;br&gt;Applicant may now use the portal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
