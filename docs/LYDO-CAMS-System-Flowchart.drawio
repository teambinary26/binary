                    <mxGeometry x="240" y="430" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="POST admin.applications.approve-applicant&lt;br&gt;draft → accepted&lt;br&gt;Activate user, issue temporary password" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
