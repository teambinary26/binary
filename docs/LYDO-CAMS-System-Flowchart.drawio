        <mxCell id="31" value="B. ELIGIBILITY EVALUATION  ·  permission applications.evaluate  ·  queue: under_evaluation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;dashPattern=8 8;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#1E3A5F;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
