                    <mxGeometry x="1790" y="820" width="230" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="94" value="ASSISTANCE PROGRAMS (seeded)&lt;br&gt;Student: Educational EDU-001 · Tuition TUI-001 · School Supplies · Transportation&lt;br&gt;General: Medical MED-001 · Burial · Emergency EMG-001 · Food FOD-001 · Livelihood LIV-001 · Other&lt;br&gt;Each program has requirements, eligibility rules (OCR or manual), and form fields.&lt;br&gt;Open if is_open, inside date window, and under slot_limit (draft/cancelled/rejected do not consume a slot)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontColor=#0F172A;" parent="1" vertex="1">
                    <mxGeometry x="40" y="920" width="740" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="95" value="ROLES &amp; ACCESS&lt;br&gt;administrator — all permissions; skips workflow_staff checks&lt;br&gt;staff — dashboard, applicants, applications (view/manage/verify/evaluate/approve),&lt;br&gt;releases, reports, announcements view; programs view-only unless granted&lt;br&gt;applicant — applicant portal only (auth + applicant middleware)&lt;br&gt;Staff may verify / evaluate / approve only with the matching permission AND&lt;br&gt;a workflow_staff row for that step (verification, evaluation, approval)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontColor=#0F172A;" parent="1" vertex="1">
                    <mxGeometry x="800" y="920" width="740" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="96" value="CONCURRENCY RULES&lt;br&gt;• One resumable draft per program (draft, accepted, for_revision, incomplete)&lt;br&gt;• Cannot start another program while a non-terminal application exists&lt;br&gt;• Cannot duplicate an active application on the same program&lt;br&gt;• Public apply creates pending accounts (is_active=false) until staff accept&lt;br&gt;• Register-first accounts are active immediately but still apply via public form&lt;br&gt;• Guest status lookup: /application-status?application_no=CAMS-…" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1B365D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;fontColor=#0F172A;" parent="1" vertex="1">
                    <mxGeometry x="1560" y="920" width="760" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="97" value="HAPPY PATH STATUSES:  draft → accepted → submitted → under_verification → under_evaluation → for_approval → approved → scheduled_for_release → released → completed&lt;br&gt;TERMINAL: completed · rejected · cancelled    |    REWORK: incomplete · for_revision (applicant returns to documents, then under_verification)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;spacingLeft=10;fontSize=11;fontColor=#0F172A;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1090" width="2280" height="64" as="geometry"/>
